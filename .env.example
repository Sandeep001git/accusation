# Application
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
JWT_SECRET=replace-with-a-long-random-secret

# Neon PostgreSQL connection string. Use the provider's pooled URL for the app
# if appropriate; include sslmode=require when required by your provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Arcjet API key (obtain from your Arcjet dashboard).
ARCJET_API_KEY=replace-with-your-arcjet-api-key

# Replace all placeholder values in .env with real credentials; never commit .env.
